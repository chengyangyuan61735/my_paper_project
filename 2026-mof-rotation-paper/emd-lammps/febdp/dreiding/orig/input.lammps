variable	a loop 50 
variable	t index 280	577	340	788	226	302	377	567	303	432	820	940	827	675	543	212	238	283	557	355	839	349	116	651	493	264	240	289	169	250	927	79	651	910	828	564	779	752	153	589	199	129	552	773	554	644	742	241	361	827
	
log			log.$a

###
variable	dt		equal	1.0
variable	T		equal	300
variable	pres	equal	0
variable	p		equal	20001
variable	s		equal	5
variable	d		equal	$p*$s
variable	r		equal	10	
variable	Np		equal	$d*$r
variable	kb		equal	1.3806485e-23
variable	kcalm2J	equal	4184.0/6.02214e23
variable	A2m		equal	1.0e-10
variable	fs2s	equal	1.0e-15	
variable	convert	equal	${kcalm2J}*${kcalm2J}/${fs2s}/${A2m}
###

units 		real
dimension 	3
boundary 	p p p 
atom_style 	full

pair_style      lj/cut 12.500
bond_style      harmonic
angle_style     hybrid cosine/squared cosine/periodic
dihedral_style  charmm
improper_style  umbrella

dielectric      1.0
special_bonds   dreiding
pair_modify     tail yes mix arithmetic
box tilt        large


# Read framework data file
read_data       data.Fe-bdp-expand
timestep        ${dt} 

###
velocity	all create $T $t mom yes rot yes dist gaussian
###

# NVT ensemble
dump		1 all custom 10000 dump.nvt$a.lammpstrj id mol type x y z 
fix 		1 all nvt temp $T $T $(100.0*dt)
thermo		1000
thermo_style	custom step temp press vol ke pe etotal lx ly lz density cpu
run			500000
unfix		1
undump		1

# NVE ensemble
dump		3 all custom 10000 dump.nve$a.lammpstrj id mol type x y z
fix			3 all nve 
run			500000
unfix		3
undump		3

reset_timestep	0
compute		KE	all	ke/atom
compute		PE	all	pe/atom
compute		Stress	all	centroid/stress/atom	NULL	virial
compute		J	all	heat/flux	KE	PE	Stress

dump		4 all custom 10000 dump.kappa$a.lammpstrj id mol type x y z
fix			4	all	nve
fix			HAFC all ave/correlate $s $p $d	c_J[1] c_J[2] c_J[3] type auto file hafc$a.txt ave running
run			${Np}
unfix		4
undump		4
clear
next		t
next		a
jump		input.lammps
