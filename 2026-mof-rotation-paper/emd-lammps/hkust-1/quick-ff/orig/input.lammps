variable	a loop 20 
variable	t index 280	577	340	788	226	302	377	567	303	432	820	940	827	675	543	212	238	283	557	355
	
log			log.$a

###
variable	dt		equal	1.0
variable	T		equal	300
variable	pres	equal	0
variable	p		equal	20001
variable	s		equal	5
variable	d		equal	$p*$s
variable	r		equal	10	
variable	Np		equal	$d*$r
variable	kb		equal	1.3806485e-23
variable	kcalm2J	equal	4184.0/6.02214e23
variable	A2m		equal	1.0e-10
variable	fs2s	equal	1.0e-15	
variable	convert	equal	${kcalm2J}*${kcalm2J}/${fs2s}/${A2m}
###

units 		real
dimension 	3
boundary 	p p p 
atom_style 	full

# ------------------------ FORCE FIELD ------------------------------
special_bonds   lj 0.000000 1.000000 1.000000 coul 0.000000 1.000000 1.000000
pair_style hybrid/overlay coul/long   15.00000000 table spline 5000
bond_style      hybrid mm3 table spline 1000
angle_style     hybrid mm3 cosine/periodic cross
dihedral_style  fourier
improper_style  distharm
box tilt large

read_data       lammps.data       
pair_coeff * * coul/long
pair_coeff 1 1 table lammps.table C_CA_00000---C_CA_00000
pair_coeff 1 2 table lammps.table C_PC_00000---C_CA_00000
pair_coeff 1 3 table lammps.table C_PH_00000---C_CA_00000
pair_coeff 1 4 table lammps.table Cu_00000---C_CA_00000
pair_coeff 1 5 table lammps.table H_PH_00000---C_CA_00000
pair_coeff 1 6 table lammps.table O_CA_00000---C_CA_00000
pair_coeff 2 2 table lammps.table C_PC_00000---C_PC_00000
pair_coeff 2 3 table lammps.table C_PH_00000---C_PC_00000
pair_coeff 2 4 table lammps.table Cu_00000---C_PC_00000
pair_coeff 2 5 table lammps.table H_PH_00000---C_PC_00000
pair_coeff 2 6 table lammps.table O_CA_00000---C_PC_00000
pair_coeff 3 3 table lammps.table C_PH_00000---C_PH_00000
pair_coeff 3 4 table lammps.table Cu_00000---C_PH_00000
pair_coeff 3 5 table lammps.table H_PH_00000---C_PH_00000
pair_coeff 3 6 table lammps.table O_CA_00000---C_PH_00000
pair_coeff 4 4 table lammps.table Cu_00000---Cu_00000
pair_coeff 4 5 table lammps.table H_PH_00000---Cu_00000
pair_coeff 4 6 table lammps.table O_CA_00000---Cu_00000
pair_coeff 5 5 table lammps.table H_PH_00000---H_PH_00000
pair_coeff 5 6 table lammps.table O_CA_00000---H_PH_00000
pair_coeff 6 6 table lammps.table O_CA_00000---O_CA_00000
kspace_style    pppm 1e-5      # Ewald accuracy
neighbor        2.0 multi
neigh_modify    every 2 delay 4 check yes


timestep        ${dt} 

###
velocity	all create $T $t mom yes rot yes dist gaussian
###

# NVT ensemble
dump		1 all custom 10000 dump.nvt$a.lammpstrj id mol type x y z 
fix 		1 all nvt temp $T $T $(100.0*dt)
thermo		1000
thermo_style	custom step temp press vol ke pe etotal lx ly lz density cpu
run			200000
unfix		1
undump		1

# NVE ensemble
dump		3 all custom 10000 dump.nve$a.lammpstrj id mol type x y z
fix			3 all nve 
run			200000
unfix		3
undump		3

reset_timestep	0
compute		KE	all	ke/atom
compute		PE	all	pe/atom
compute		Stress	all	stress/atom	NULL	virial
compute		J	all	heat/flux	KE	PE	Stress

dump		4 all custom 10000 dump.kappa$a.lammpstrj id mol type x y z
fix			4	all	nve
fix			HAFC all ave/correlate $s $p $d	c_J[1] c_J[2] c_J[3] type auto file hafc$a.txt ave running
run			${Np}
unfix		4
undump		4
clear
next		t
next		a
jump		input.lammps

