variable	a loop 30 
variable	t index 280	577	340	788	226	302	377	567	303	432	820	940	827	675	543	212	238	283	557	355	839	349	116	651	493	264	240	289	169	250
	
log			log.$a

###
variable	dt		equal	1.0
variable	T		equal	300
variable	pres	equal	0
variable	p		equal	20001
variable	s		equal	5
variable	d		equal	$p*$s
variable	r		equal	10	
variable	Np		equal	$d*$r
variable	kb		equal	1.3806485e-23
variable	kcalm2J	equal	4184.0/6.02214e23
variable	A2m		equal	1.0e-10
variable	fs2s	equal	1.0e-15	
variable	convert	equal	${kcalm2J}*${kcalm2J}/${fs2s}/${A2m}
###

units 		real
dimension 	3
boundary 	p p p 
atom_style 	full

# Read framework data file
read_data 		zif8-h.data
timestep        ${dt} 

# ------------------------ MOF-FF FORCE FIELD ------------------------------

